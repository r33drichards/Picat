# SIMD is opt-in: SIMD=1 requires a runtime with WebAssembly SIMD support.
SIMD ?= 0
ifneq ($(SIMD),0)
ifneq ($(SIMD),1)
$(error SIMD must be 0 or 1)
endif
endif
SIMD_FLAGS =
ifeq ($(SIMD),1)
SIMD_FLAGS = -msimd128
endif

EXT = .js
CPP    = em++ $(SIMD_FLAGS) -DGC -DGCC -DPICAT -DSAT -DFANN_NO_DLL -DFANN
CC     = emcc $(SIMD_FLAGS) -DGC -DGCC -DPICAT -DSAT -DFANN_NO_DLL -DFANN
CCC=$(CC) -c
CPPC=$(CPP) -c

CFLAGS = -O2 -fno-strict-aliasing -finline-functions -fomit-frame-pointer -Dunix -DLINUX -DPOSIX -Wno-error=unused-label

LFLAGS = -lm \
	-sALLOW_MEMORY_GROWTH=1 \
	-sINITIAL_MEMORY=128MB \
	-sSTACK_SIZE=8MB \
	-sEXIT_RUNTIME=1 \
	-sENVIRONMENT=web,worker,node \
	-sEXPORTED_RUNTIME_METHODS=FS,callMain \
	-sAUTO_NATIVE_LIBRARIES=0 \
	-sNO_DISABLE_EXCEPTION_CATCHING

include common.mak

# common.mak shares object names across configurations. Rebuild all objects when
# compiler/linker flags change, including a switch back from SIMD to scalar.
.PHONY: emscripten-config-force
.emscripten-build-config: emscripten-config-force
	@printf '%s\n' '$(CC)' '$(CPP)' '$(CFLAGS)' '$(LFLAGS)' '$(ESPRESSO_FLAGS)' '$(KISSAT_FLAGS)' > $@.tmp
	@cmp -s $@.tmp $@ || cp $@.tmp $@
	@rm -f $@.tmp

$(OBJ) $(ESPRESSO_OBJ) $(KISSAT_OBJ): .emscripten-build-config
